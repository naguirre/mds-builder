bootstrap=1

# RAM layout for the FEL bootstrap (DRAM 0x80000000..0x84000000, 64 MiB).
# Kept disjoint so bootm's relocation never overrides a neighbour:
#   kernel_addr  : uImage source, copied by bootm to its 0x82000000 load address
#   ramdisk_addr : initramfs, above the kernel (out of the kernel-reserved low zone)
#   fdt_addr     : DTB, above the initramfs
#   *_high       : relocation ceiling (NOT 0xffffffff, which warns on FDT alignment)
kernel_addr=0x80000000
ramdisk_addr=0x82800000
fdt_addr=0x83A00000
initrd_high=0x83C00000
fdt_high=0x83C00000

bootcmd_bootstrap=env set bootargs rootwait rw console=ttyS0,115200; bootm ${kernel_addr} ${ramdisk_addr} ${fdt_addr}
bootcmd=run bootcmd_bootstrap
